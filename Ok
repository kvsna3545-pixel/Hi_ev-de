        function Tab:CreateDropdown(cfg)
            cfg = cfg or {}
            local options = cfg.Values or cfg.Options or {}
            local state = cfg.Default or options[1] or ""
            local isOpen = false
            local activeMenu = nil

            local Holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = THEME.BgMid,
                BorderSizePixel = 0,
            }, TabScroll)
            Corner(Holder, 8)
            Stroke(Holder, THEME.Stroke, 0.5, 1)

            New("TextLabel", {
                Size = UDim2.new(1, -130, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Text = cfg.Name or "Dropdown",
                TextColor3 = THEME.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, Holder)

            local SelectorBtn = New("TextButton", {
                Size = UDim2.new(0, 115, 0, 26),
                Position = UDim2.new(1, -125, 0.5, -13),
                BackgroundColor3 = THEME.BgDark,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
            }, Holder)
            Corner(SelectorBtn, 6)

            local SelText = New("TextLabel", {
                Size = UDim2.new(1, -22, 1, 0),
                Position = UDim2.fromOffset(8, 0),
                BackgroundTransparency = 1,
                Text = tostring(state),
                TextColor3 = THEME.Accent2,
                TextSize = 11,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, SelectorBtn)

            local Arrow = New("TextLabel", {
                Size = UDim2.fromOffset(14, 14),
                Position = UDim2.new(1, -18, 0.5, -7),
                BackgroundTransparency = 1,
                Text = "▾",
                TextColor3 = THEME.TextDim,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
            }, SelectorBtn)

            local function CloseMenu()
                if activeMenu then activeMenu:Destroy(); activeMenu = nil end
                isOpen = false
                Tween(Arrow, 0.2, {Rotation = 0})
                Tween(SelectorBtn, 0.15, {BackgroundColor3 = THEME.BgDark})
            end

            local function OpenMenu()
                for _, c in ipairs(Tab.Window.Overlay:GetChildren()) do
                    if c:IsA("Frame") and c.Name == "DropMenu" then c:Destroy() end
                end
                local overlay = Tab.Window.Overlay
                local selPos = SelectorBtn.AbsolutePosition
                local ovPos  = overlay.AbsolutePosition
                local menuHeight = math.min(#options * 26 + 8, 180)

                local relX = selPos.X - ovPos.X + SelectorBtn.AbsoluteSize.X - 115
                local relY = selPos.Y - ovPos.Y + SelectorBtn.AbsoluteSize.Y + 4

                if relY + menuHeight > overlay.AbsoluteSize.Y then
                    relY = selPos.Y - ovPos.Y - menuHeight - 4
                end
                relX = math.max(0, math.min(relX, overlay.AbsoluteSize.X - 115))
                relY = math.max(4, relY)

                local Menu = New("Frame", {
                    Name = "DropMenu",
                    Position = UDim2.fromOffset(relX, relY),
                    Size = UDim2.fromOffset(115, 0),
                    BackgroundColor3 = THEME.BgDark,
                    BorderSizePixel = 0,
                    ZIndex = 500,
                    ClipsDescendants = true,
                }, overlay)
                Corner(Menu, 6)
                Stroke(Menu, THEME.Accent, 0.4, 1)
                activeMenu = Menu

                local MenuList = New("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = THEME.Accent,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ZIndex = 501,
                }, Menu)
                New("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, MenuList)
                New("UIPadding", {PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4)}, MenuList)

                for i, opt in ipairs(options) do
                    local OptBtn = New("TextButton", {
                        Size = UDim2.new(1, 0, 0, 24),
                        BackgroundColor3 = THEME.BgHover,
                        BackgroundTransparency = 1,
                        BorderSizePixel = 0,
                        Text = tostring(opt),
                        TextColor3 = THEME.Text,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        AutoButtonColor = false,
                        ZIndex = 502,
                        LayoutOrder = i,
                    }, MenuList)
                    Corner(OptBtn, 4)
                    New("UIPadding", {PaddingLeft = UDim.new(0, 8)}, OptBtn)
                    OptBtn.MouseEnter:Connect(function() Tween(OptBtn, 0.1, {BackgroundTransparency = 0}) end)
                    OptBtn.MouseLeave:Connect(function() Tween(OptBtn, 0.1, {BackgroundTransparency = 1}) end)
                    OptBtn.Activated:Connect(function()
                        state = opt
                        SelText.Text = tostring(opt)
                        if cfg.Callback then pcall(cfg.Callback, opt) end
                        CloseMenu()
                    end)
                end

                Tween(Menu, 0.18, {Size = UDim2.fromOffset(115, menuHeight)}, Enum.EasingStyle.Back)
