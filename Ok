        UserInputService.InputChanged:Connect(
            function(Input)
                if not Dragging then
                    return
                end

                if not DragInput then
                    return
                end

                local IsMouse =
                    DragInput.UserInputType
                        == Enum.UserInputType.MouseButton1
                    and Input.UserInputType
                        == Enum.UserInputType.MouseMovement

                local IsTouch =
                    DragInput.UserInputType
                        == Enum.UserInputType.Touch
                    and Input == DragInput

                if not (
                    IsMouse
                    or IsTouch
                ) then
                    return
                end

                local Delta =
                    Vector2.new(
                        Input.Position.X
                            - DragOrigin.X,

                        Input.Position.Y
                            - DragOrigin.Y
                    )

                if not Moved then
                    if Delta.Magnitude
                        < CONFIG.DragThreshold then
                        return
                    end

                    Moved = true

                    DragOrigin =
                        Input.Position

                    DragStartPos =
                        Target

                    Tween(
                        Scale,
                        0.15,
                        {
