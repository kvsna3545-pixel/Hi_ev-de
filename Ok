-- =========================================================
-- KRYVEX HUB - Custom GUI Library (v2)
-- =========================================================
local KOMAT = (function()
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")

    local THEME = {
        BgDark   = Color3.fromRGB(15, 15, 20),
        BgMid    = Color3.fromRGB(22, 22, 30),
        BgLight  = Color3.fromRGB(30, 30, 40),
        BgHover  = Color3.fromRGB(42, 42, 55),
        Accent   = Color3.fromRGB(138, 100, 255),
        Accent2  = Color3.fromRGB(100, 200, 255),
        Text     = Color3.fromRGB(240, 240, 245),
        TextDim  = Color3.fromRGB(155, 155, 170),
        TextFaint= Color3.fromRGB(100, 100, 120),
        Stroke   = Color3.fromRGB(50, 50, 68),
        Danger   = Color3.fromRGB(220, 70, 70),
    }

    local function New(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        if parent then o.Parent = parent end
        return o
    end
    local function Corner(obj, r)
        return New("UICorner", {CornerRadius = UDim.new(0, r)}, obj)
    end
    local function Stroke(obj, c, t, th)
        return New("UIStroke", {Color = c or THEME.Stroke, Transparency = t or 0, Thickness = th or 1}, obj)
    end
    local function Tween(obj, time, props, style, dir)
        local t = TweenService:Create(obj,
            TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
        t:Play(); return t
    end
    local function GetGuiParent()
        if gethui then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        return game:GetService("CoreGui")
    end

    -- =====================================================
    -- WINDOW
    -- =====================================================
