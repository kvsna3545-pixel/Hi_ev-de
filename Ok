    local function Sweep()
        -- กวาดของตกค้าง (รวมของจากสคริปต์เวอร์ชันเก่า) เฉพาะในโฟลเดอร์ผู้เล่น
        local Roots = GetFolders()
        for _, P in ipairs(Players:GetPlayers()) do
            if P.Character then Roots[#Roots + 1] = P.Character end
        end
        for _, R in ipairs(Roots) do
            for _, Obj in ipairs(R:GetDescendants()) do
                if SweepNames[Obj.Name] then
                    pcall(function() Obj:Destroy() end)
                end
            end
        end
    end

