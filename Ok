do
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    -- กันรันซ้ำ: เคลียร์ตัวเก่าก่อน
    local Env = (getgenv and getgenv()) or _G
    if Env.KOMAT_DownedESP_Cleanup then
        pcall(Env.KOMAT_DownedESP_Cleanup)
    end

    local DownedHealth = 2
    local CheckDelay = 0.05

    local Enabled = false
    local Connection = nil
    local Data = {}
    local Container = nil
    local SkyPart, SkyAttachment = nil, nil
    local LastCheck = 0

    local SweepNames = {
        KOMAT_DownedName = true,
        KOMAT_DownedHighlight = true,
        KOMAT_DownedLine = true,
        KOMAT_DownedESP_Sky = true,
    }

    local function GetGuiParent()
        local ok, parent = pcall(function()
            if gethui then return gethui() end
            return game:GetService("CoreGui")
        end)
        if ok and parent then return parent end
        return LocalPlayer:WaitForChild("PlayerGui")
    end

    local function GetFolders()
        local list = {}
        local A = workspace:FindFirstChild("Players")
        if A then list[#list + 1] = A end
        local G = workspace:FindFirstChild("Game")
        local B = G and G:FindFirstChild("Players")
        if B then list[#list + 1] = B end
        return list
    end

    local function CollectModels()
        local Models, Seen = {}, {}
        local function Add(M)
            if M and M:IsA("Model") and not Seen[M] and M:IsDescendantOf(workspace) then
                Seen[M] = true
                Models[#Models + 1] = M
            end
        end
        for _, P in ipairs(Players:GetPlayers()) do
            Add(P.Character)
        end
        for _, F in ipairs(GetFolders()) do
            for _, C in ipairs(F:GetChildren()) do
                Add(C)
            end
        end
        return Models
    end

    local function FindPlayer(Model)
        local P = Players:GetPlayerFromCharacter(Model)
        if P then return P end

        local Tag = Model:GetAttribute("Tag") or Model:GetAttribute("ID") or Model.Name
        for _, Pl in ipairs(Players:GetPlayers()) do
            if Pl.Name == Model.Name
                or Pl.DisplayName == Model.Name
                or tostring(Pl.UserId) == tostring(Tag)
                or (Pl:GetAttribute("Tag") and tostring(Pl:GetAttribute("Tag")) == tostring(Tag)) then
                return Pl
            end
        end
        return nil
    end

    local function IsDowned(Model, Humanoid)
        if Model:GetAttribute("Downed") == true then
            return true
        end
        return Humanoid.Health <= DownedHealth
    end

    local function Remove(Model)
        local D = Data[Model]
        if not D then return end
        Data[Model] = nil

        for _, Key in ipairs({ "Gui", "Highlight", "Beam", "Attachment" }) do
            local Obj = D[Key]
            if Obj then
                pcall(function() Obj:Destroy() end)
            end
        end
    end

    local function RemoveAll()
        for Model in pairs(Data) do
            Remove(Model)
        end
        Data = {}
