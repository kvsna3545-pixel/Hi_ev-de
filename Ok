        function Tab:CreateToggle(cfg)
            cfg = cfg or {}
            local state = cfg.Default or false

            local Holder = New("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = THEME.BgMid,
                BorderSizePixel = 0,
            }, TabScroll)
            Corner(Holder, 8)
            local HolderStroke = Stroke(Holder, THEME.Stroke, 0.5, 1)

            New("TextLabel", {
                Size = UDim2.new(1, -70, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Text = cfg.Name or "Toggle",
                TextColor3 = THEME.Text,
                TextSize = 12,
                Font = Enum.Font.GothamMedium,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, Holder)

            local SwitchBg = New("Frame", {
                Size = UDim2.fromOffset(40, 20),
                Position = UDim2.new(1, -52, 0.5, -10),
                BackgroundColor3 = THEME.BgHover,
                BorderSizePixel = 0,
            }, Holder)
            Corner(SwitchBg, 10)

            local Knob = New("Frame", {
                Size = UDim2.fromOffset(16, 16),
                Position = UDim2.fromOffset(2, 2),
                BackgroundColor3 = THEME.TextDim,
                BorderSizePixel = 0,
            }, SwitchBg)
            Corner(Knob, 8)

            local Click = New("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
            }, Holder)

            local function Set(value, fire)
                state = value
                if value then
                    Tween(SwitchBg, 0.2, {BackgroundColor3 = THEME.Accent})
                    Tween(Knob, 0.2, {Position = UDim2.fromOffset(22, 2), BackgroundColor3 = THEME.Text})
                    Tween(HolderStroke, 0.2, {Color = THEME.Accent, Transparency = 0.6})
                else
                    Tween(SwitchBg, 0.2, {BackgroundColor3 = THEME.BgHover})
                    Tween(Knob, 0.2, {Position = UDim2.fromOffset(2, 2), BackgroundColor3 = THEME.TextDim})
                    Tween(HolderStroke, 0.2, {Color = THEME.Stroke, Transparency = 0.5})
                end
                if fire and cfg.Callback then pcall(cfg.Callback, value) end
            end

            Click.Activated:Connect(function() Set(not state, true) end)
            Click.MouseEnter:Connect(function() Tween(Holder, 0.15, {BackgroundColor3 = THEME.BgLight}) end)
            Click.MouseLeave:Connect(function() Tween(Holder, 0.15, {BackgroundColor3 = THEME.BgMid}) end)

            Set(state, false)
        end

        function Tab:CreateButton(cfg)
            cfg = cfg or {}
            local Btn = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = THEME.BgMid,
                BorderSizePixel = 0,
                Text = cfg.Name or "Button",
