    local function StopDashJump()
        DashJumpEnabled = false

        if DashJumpConnection then
            DashJumpConnection:Disconnect()
            DashJumpConnection = nil
        end

        if DashJumpVelocity then
            DashJumpVelocity:Destroy()
            DashJumpVelocity = nil
        end
    end

    local function StartDashJump()
        if DashJumpConnection then
            DashJumpConnection:Disconnect()
            DashJumpConnection = nil
        end

        DashJumpConnection = RunService.Heartbeat:Connect(function()
            if not DashJumpEnabled then
                return
            end

            local Character = LocalPlayer.Character

            if not Character then
                return
            end

            local Root = Character:FindFirstChild("HumanoidRootPart")
            local Humanoid = Character:FindFirstChildOfClass("Humanoid")
            local Camera = workspace.CurrentCamera

            if not Root or not Humanoid or not Camera then
                return
            end

            if not DashJumpVelocity then
                DashJumpVelocity = Instance.new("BodyVelocity")
                DashJumpVelocity.MaxForce = Vector3.new(
                    999999,
                    0,
                    999999
                )
                DashJumpVelocity.P = 1250
                DashJumpVelocity.Parent = Root

            elseif DashJumpVelocity.Parent ~= Root then
                DashJumpVelocity:Destroy()

                DashJumpVelocity = Instance.new("BodyVelocity")
                DashJumpVelocity.MaxForce = Vector3.new(
                    999999,
                    0,
                    999999
                )
                DashJumpVelocity.P = 1250
                DashJumpVelocity.Parent = Root
            end

            local Direction = Camera.CFrame.LookVector

            Direction = Vector3.new(
                Direction.X,
                0,
                Direction.Z
            )

            if Direction.Magnitude > 0 then
                Direction = Direction.Unit

                DashJumpVelocity.Velocity =
                    Direction * DashJumpSpeed
            end

            local Params = RaycastParams.new()

            Params.FilterType =
                Enum.RaycastFilterType.Exclude

            Params.FilterDescendantsInstances = {
                Character
            }

            local Result = workspace:Raycast(
                Root.Position,
                Vector3.new(0, -4, 0),
                Params
            )

            if Result then
                Humanoid:ChangeState(
                    Enum.HumanoidStateType.Jumping
                )
            end
        end)
