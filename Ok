        return self
    end

    function Window:CreateTab(name, iconName)
        local Tab = {}
        Tab.__index = Tab
        Tab.Window = self

        local TabBtn = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = THEME.BgLight,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = #self.Tabs + 1,
        }, self.Sidebar)
        Corner(TabBtn, 6)

        local Indicator = New("Frame", {
            Size = UDim2.fromOffset(3, 18),
            Position = UDim2.new(0, 3, 0.5, -9),
            BackgroundColor3 = THEME.Accent,
            BorderSizePixel = 0,
            BackgroundTransparency = 1,
        }, TabBtn)
        Corner(Indicator, 2)

        local TabText = New("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.fromOffset(14, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = THEME.TextDim,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, TabBtn)

        local TabScroll = New("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = THEME.Accent,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 2,
        }, self.ContentHolder)
        New("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, TabScroll)
        New("UIPadding", {PaddingRight = UDim.new(0, 8)}, TabScroll)

        Tab.Scroll = TabScroll
        Tab.Btn = TabBtn

        local function Activate()
            for _, t in ipairs(self.Tabs) do
                t.Scroll.Visible = false
                Tween(t.Btn, 0.2, {BackgroundTransparency = 1})
            end
            TabScroll.Visible = true
            Tween(TabBtn, 0.2, {BackgroundTransparency = 0})
        end

        TabBtn.MouseEnter:Connect(function()
            if self.ActiveTab ~= Tab then Tween(TabBtn, 0.15, {BackgroundTransparency = 0.5}) end
        end)
        TabBtn.MouseLeave:Connect(function()
            if self.ActiveTab ~= Tab then Tween(TabBtn, 0.15, {BackgroundTransparency = 1}) end
        end)
        TabBtn.Activated:Connect(function()
            self.ActiveTab = Tab
            Activate()
        end)

        table.insert(self.Tabs, Tab)
        if #self.Tabs == 1 then
            self.ActiveTab = Tab
            Activate()
        end

        -- =================================================
        -- COMPONENTS
        -- =================================================

