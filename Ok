    local function Check()
        if not Enabled then return end

        local Seen = {}

        for _, Model in ipairs(CollectModels()) do
            local Humanoid = Model:FindFirstChildOfClass("Humanoid")
            local Root = Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart

            if Humanoid and Root and Model ~= LocalPlayer.Character then
                local Player = FindPlayer(Model)

                if Player ~= LocalPlayer and IsDowned(Model, Humanoid) then
                    Seen[Model] = true

                    local D = Data[Model]
                    -- Root/Humanoid ถูกเปลี่ยน → สร้างใหม่
                    if D and (D.Root ~= Root or D.Humanoid ~= Humanoid) then
                        Remove(Model)
                        D = nil
                    end

                    if not D then
                        Create(Model, Player, Humanoid, Root)
                    else
                        D.Status.Text = "⚠ DOWNED • HP " .. math.floor(Humanoid.Health)
                    end
                end
            end
        end

        -- อะไรที่ tick นี้ไม่เจอ / ไม่ล้มแล้ว / หายจากแมพ → ลบทิ้งหมด
        for Model in pairs(Data) do
            if not Seen[Model] then
                Remove(Model)
            end
        end
    end

    local function Stop()
        Enabled = false

        if Connection then
            Connection:Disconnect()
            Connection = nil
        end

        RemoveAll()

        if Container then
            pcall(function() Container:Destroy() end)
            Container = nil
        end
        if SkyPart then
            pcall(function() SkyPart:Destroy() end)
            SkyPart, SkyAttachment = nil, nil
        end

        Sweep()
    end

    local function Start()
        Stop()
        Enabled = true

        Container = Instance.new("Folder")
        Container.Name = "KOMAT_DownedESP"
        Container.Parent = GetGuiParent()

        CreateSky()
        LastCheck = 0
        Check()

        Connection = RunService.Heartbeat:Connect(function()
            if not Enabled then return end

            UpdateSky()

            local Now = os.clock()
            if Now - LastCheck >= CheckDelay then
                LastCheck = Now
                Check()
            end
        end)
    end

    Env.KOMAT_DownedESP_Cleanup = Stop

